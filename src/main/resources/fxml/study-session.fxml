<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.studytrack.controller.StudySessionController"
      alignment="CENTER"
      spacing="20">

    <padding>
        <Insets top="30"
                right="30"
                bottom="30"
                left="30"/>
    </padding>

    <Label text="Study Session"/>

    <Label text="Select a task to study:"/>

    <ComboBox fx:id="taskComboBox"
              prefWidth="350"
              promptText="Select a task"/>

    <Label text="Ready to study?"/>

    <Label fx:id="timerLabel"
           text="00:00:00"/>

    <Button fx:id="startSessionButton"
            text="Start Session"
            onAction="#handleStartSession"/>

    <Button fx:id="pauseSessionButton"
            text="Pause"
            onAction="#handlePauseSession"/>

    <Button fx:id="stopSessionButton"
            text="Stop"
            onAction="#handleStopSession"/>

    <Button fx:id="backToDashboardButton"
            text="Back to Dashboard"
            onAction="#handleBackToDashboard"/>

</VBox>

