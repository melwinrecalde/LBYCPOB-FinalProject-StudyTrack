<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.studytrack.controller.DashboardController"
      spacing="15"
      alignment="CENTER">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Label text="StudyTrack Dashboard"/>

    <!-- Task Statistics -->

    <HBox spacing="20">

        <VBox spacing="5" alignment="CENTER">
            <Label text="Total Tasks"/>
            <Label fx:id="totalTasksLabel"
                   text="0"/>
        </VBox>

        <VBox spacing="5" alignment="CENTER">
            <Label text="Pending"/>
            <Label fx:id="pendingTasksLabel"
                   text="0"/>
        </VBox>

        <VBox spacing="5" alignment="CENTER">
            <Label text="In Progress"/>
            <Label fx:id="inProgressTasksLabel"
                   text="0"/>
        </VBox>

        <VBox spacing="5" alignment="CENTER">
            <Label text="Completed"/>
            <Label fx:id="completedTasksLabel"
                   text="0"/>
        </VBox>

        <VBox spacing="5" alignment="CENTER">
            <Label text="Overdue"/>
            <Label fx:id="overdueTasksLabel"
                   text="0"/>
        </VBox>

    </HBox>

    <!-- Search and Filters -->

    <HBox spacing="10">

        <TextField fx:id="searchField"
                   promptText="Search tasks..."
                   prefWidth="250"
                   onAction="#handleSearch"/>

        <ComboBox fx:id="statusFilterComboBox"
                  promptText="Filter by Status"
                  prefWidth="150"/>

        <ComboBox fx:id="priorityFilterComboBox"
                  promptText="Filter by Priority"
                  prefWidth="150"/>

        <Button text="Clear Filters"
                onAction="#handleClearFilters"/>

    </HBox>

    <!-- Task List -->

    <ListView fx:id="taskListView"
              prefWidth="700"
              prefHeight="400"/>

    <!-- Actions -->

    <HBox spacing="10">

        <Button text="Add Task"
                onAction="#handleAddTask"/>

        <Button text="Edit Task"
                onAction="#handleEditTask"/>

        <Button text="Delete Task"
                onAction="#handleDeleteTask"/>

        <Button text="Start Studying"
                onAction="#handleStartStudying"/>

    </HBox>

</VBox>