<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.studytrack.controller.EditTaskController"
      spacing="15"
      alignment="CENTER">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Label text="Edit Academic Task"/>

    <GridPane hgap="10" vgap="10">

        <Label text="Title:"
               GridPane.rowIndex="0"
               GridPane.columnIndex="0"/>

        <TextField fx:id="titleField"
                   promptText="e.g. OOP Final Project"
                   GridPane.rowIndex="0"
                   GridPane.columnIndex="1"/>

        <Label text="Description:"
               GridPane.rowIndex="1"
               GridPane.columnIndex="0"/>

        <TextArea fx:id="descriptionArea"
                  promptText="e.g. Complete the final project documentation"
                  prefRowCount="3"
                  GridPane.rowIndex="1"
                  GridPane.columnIndex="1"/>

        <Label text="Task Type:"
               GridPane.rowIndex="2"
               GridPane.columnIndex="0"/>

        <ComboBox fx:id="taskTypeComboBox"
                  GridPane.rowIndex="2"
                  GridPane.columnIndex="1"/>

        <Label text="Due Date:"
               GridPane.rowIndex="3"
               GridPane.columnIndex="0"/>

        <DatePicker fx:id="dueDatePicker"
                    promptText="e.g. 08/25/2026"
                    GridPane.rowIndex="3"
                    GridPane.columnIndex="1"/>

        <Label text="Due Time:"
               GridPane.rowIndex="4"
               GridPane.columnIndex="0"/>

        <TextField fx:id="dueTimeField"
                   promptText="e.g. 23:59"
                   GridPane.rowIndex="4"
                   GridPane.columnIndex="1"/>

        <Label text="Priority:"
               GridPane.rowIndex="5"
               GridPane.columnIndex="0"/>

        <ComboBox fx:id="priorityComboBox"
                  GridPane.rowIndex="5"
                  GridPane.columnIndex="1"/>

        <Label text="Status:"
               GridPane.rowIndex="6"
               GridPane.columnIndex="0"/>

        <ComboBox fx:id="statusComboBox"
                  GridPane.rowIndex="6"
                  GridPane.columnIndex="1"/>

        <Label text="Subject:"
               GridPane.rowIndex="7"
               GridPane.columnIndex="0"/>

        <ComboBox fx:id="subjectComboBox"
                  GridPane.rowIndex="7"
                  GridPane.columnIndex="1"/>

    </GridPane>

    <Button text="Save Changes"
            onAction="#handleSaveChanges"/>

    <Button fx:id="cancelButton"
            text="Cancel"/>

</VBox>